{% extends "_base/attribute.html.jinja" %}

{% block docstring scoped %}
  {% set pydantic = attribute.extra.griffe_pydantic or {} %}
  {% set constraints = pydantic.constraints or {} %}
  {% set declared = constraints.validation_alias | string if constraints.validation_alias else "" %}
  {% set wire = constraints.serialization_alias or constraints.alias or (declared if declared[:1] in ["'", '"'] else None) %}
  {% set read_from = constraints.validation_alias if declared != wire | string else None %}
  {% if wire or read_from %}
    <p class="ec-wire-key">
      {% if wire %}Wire key <code>{{ wire | string | trim("'\"") }}</code>{% endif %}
      {% if read_from %}Read from <code>{{ read_from | string }}</code>{% endif %}
    </p>
  {% endif %}
  {{ super() }}
{% endblock docstring %}
